{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules"
    ],
    "rewrites": [
      {
        "source": "/404",
        "destination": "/404.html"
      }
    ],
    "errorPage": "/404.html"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
