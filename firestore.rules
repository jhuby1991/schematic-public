rules_version = '2';

// Security rules for the rako-system-designer Firebase project's Firestore
// database. These are what make an issue stamp trustworthy: the tool's code
// is public, but only these rules decide what goes into the register.
//
// This is the project's complete rule set: publishing it replaces everything
// in Firestore Database > Rules, so keep it in step with the console.
service cloud.firestore {
  match /databases/{database}/documents {

    // Saved schematics from the private version of the tool: Rako staff only.
    match /schematics/{schematicId} {
      allow read, write: if request.auth != null
        && request.auth.token.email.matches('.*@rakocontrols[.]com$');
    }

    // Tool usage records: Rako staff only.
    match /toolUsage/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email.matches('.*@rakocontrols[.]com$');
    }

    // Drawings issued by Rako staff from the schematic tool (sales.js).
    match /issuedDrawings/{code} {
      function isStaff() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower().matches('.*@rakocontrols[.]com');
      }

      // Anyone holding a code can look it up (the check page), but nobody
      // can list the register or search it.
      allow get: if true;
      allow list: if false;

      // Only a signed-in @rakocontrols.com account can add a drawing, only
      // in its own name, stamped with the database's own clock, and never
      // on top of an existing code (that would be an update, not a create).
      allow create: if isStaff()
        && code.matches('RK-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}')
        && request.resource.data.code == code
        && request.resource.data.issuedBy.uid == request.auth.uid
        && request.resource.data.issuedBy.email == request.auth.token.email
        && request.resource.data.issuedBy.name is string
        && request.resource.data.issuedAt == request.time
        && request.resource.data.withdrawn == false
        && request.resource.data.drawing is string
        && request.resource.data.drawing.size() < 900000
        && !('withdrawnAt' in request.resource.data);

      // The person who issued a drawing can withdraw it - once, and nothing else.
      allow update: if isStaff()
        && resource.data.issuedBy.uid == request.auth.uid
        && resource.data.withdrawn == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawn', 'withdrawnAt'])
        && request.resource.data.withdrawn == true
        && request.resource.data.withdrawnAt == request.time;

      // Issued drawings are a record: never deleted from the tool.
      allow delete: if false;
    }
  }
}
